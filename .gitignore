# Agent worktrees created by Claude Code's worktree isolation
.claude/worktrees/

# Local scratch PDFs / image inputs (not part of any skill)
pdf/

# macOS Finder metadata
.DS_Store

# Python bytecode from the checkup script
__pycache__/
*.pyc


# Personal scratch notes, kept local
todo.md
copy-skill.md

# Type declarations the engine writes beside a mod each time it loads one
mods/*/.claude-plugin/types/

# The tsconfig the engine writes beside a mod it loads, extending the types above
mods/*/tsconfig.json
